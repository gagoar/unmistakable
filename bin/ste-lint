#!/bin/sh
# ste-lint: picks and runs the prebuilt binary for this machine.
set -eu

here="$(cd "$(dirname "$0")" && pwd)"
ext=""

case "$(uname -s)" in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  MINGW*|MSYS*|CYGWIN*) os=windows; ext=.exe ;;
  *) echo "ste-lint: unsupported OS $(uname -s)" >&2; exit 1 ;;
esac

case "$(uname -m)" in
  arm64|aarch64) arch=arm64 ;;
  x86_64|amd64) arch=amd64 ;;
  *) echo "ste-lint: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac

bin="$here/ste-lint-$os-$arch$ext"
if [ ! -x "$bin" ]; then
  echo "ste-lint: no binary for $os/$arch at $bin (run build.sh)" >&2
  exit 1
fi

exec "$bin" "$@"
